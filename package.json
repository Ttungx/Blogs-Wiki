{
  "name": "blogs-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test:update": "tsx scripts/update/smoke.ts",
    "audit:source": "tsx --env-file-if-exists=.env scripts/update/audit.ts",
    "update": "tsx --env-file-if-exists=.env scripts/update/index.ts",
    "update:dry": "tsx --env-file-if-exists=.env scripts/update/index.ts --dry-run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "@mozilla/readability": "^0.6.0",
    "astro": "^7.2.0",
    "defuddle": "^0.19.2",
    "jsdom": "^29.1.1",
    "katex": "^0.18.4",
    "pagefind": "^1.5.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2"
  }
}
