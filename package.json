{
  "name": "blogs-wiki",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/inject-worker-entry.js",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy --config wrangler.deploy.jsonc",
    "preview:worker": "npm run build && wrangler dev --config wrangler.deploy.jsonc",
    "check": "astro check",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test:update": "tsx --test scripts/update/dedupe.test.ts scripts/update/runner.test.ts scripts/update/urls.test.ts scripts/update/integrity.test.ts scripts/update/api-source.test.ts scripts/update/blocked-sources.test.ts scripts/update/quality-model.test.ts && tsx scripts/update/smoke.ts",
    "test:quality": "tsx --test scripts/update/quality-model.test.ts",
    "test:worker": "tsx --test worker/__tests__/*.test.ts",
    "test:d1": "vitest run",
    "test:markdown": "tsx --test src/lib/server/markdown.test.ts",
    "audit:source": "tsx --env-file-if-exists=.env scripts/update/audit.ts",
    "block:source": "tsx scripts/update/block-source.ts",
    "backfill": "tsx --env-file-if-exists=.env scripts/update/backfill.ts",
    "translate:batch": "tsx --env-file-if-exists=.env scripts/update/batch-translate.ts",
    "update": "tsx --env-file-if-exists=.env scripts/update/index.ts",
    "update:dry": "tsx --env-file-if-exists=.env scripts/update/index.ts --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "@mozilla/readability": "^0.6.0",
    "@shikijs/engine-javascript": "^4.4.3",
    "astro": "^7.2.0",
    "defuddle": "^0.19.2",
    "hast-util-to-string": "^3.0.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.4",
    "linkedom": "^0.18.13",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "shiki": "^4.4.3",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/vitest-pool-workers": "^0.20.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.1"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "$wrangler"
    }
  }
}
