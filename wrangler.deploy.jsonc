{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blogs-wiki",
  "main": "./dist/server/_entry.mjs",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 内容更新定时触发：每 15 分钟 ping Render runner 一次（单源轮转）。
  // 2026-09-02 曾因全量 sync 打爆 D1 日写入而暂停；增量 sync（A/B/C）落地后恢复。
  // 见 docs/d1-write-budget.md。
  "triggers": {
    "crons": ["7,22,37,52 * * * *"]
  },
  "vars": {
    "RUNNER_URL": "https://blogs-wiki-updater.onrender.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogs-wiki",
      "database_id": "6dd813ef-7d75-45ba-9a01-af3958b69725",
      "migrations_dir": "worker/migrations"
    }
  ],
}
