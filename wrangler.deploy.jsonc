{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blogs-wiki",
  "main": "./dist/server/_entry.mjs",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 内容更新定时触发：每 15 分钟 ping Render runner 一次（单源轮转）。
  // 25 源 × 15 分钟时间片取模 → 每源约 6.25 小时一更；
  // ping 同时让免费实例保持常驻（约 720h/月 < 750h 免费额度），消除冷启动。
  // ⚠️ 触发暂缓上线（2026-08-29）：crons 置空，自动工作流不启动；
  //    上线放行时恢复 ["7,22,37,52 * * * *"] 再 deploy。
  //    RUNNER_URL 部署 Render 服务后填实际地址，如 https://blogs-wiki-updater.onrender.com
  "triggers": {
    "crons": []
  },
  "vars": {
    "RUNNER_URL": "https://blogs-wiki-updater.onrender.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogs-wiki",
      "database_id": "6dd813ef-7d75-45ba-9a01-af3958b69725",
      "migrations_dir": "worker/migrations"
    }
  ],
}
