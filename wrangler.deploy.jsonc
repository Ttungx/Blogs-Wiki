{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blogs-wiki",
  "main": "./dist/server/_entry.mjs",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 内容更新定时触发：每小时 ping Render runner 一次（单源轮转）。
  // RUNNER_URL 部署 Render 服务后填实际地址，如 https://blogs-wiki-updater.onrender.com
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "vars": {
    "RUNNER_URL": ""
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogs-wiki",
      "database_id": "6dd813ef-7d75-45ba-9a01-af3958b69725",
      "migrations_dir": "worker/migrations"
    }
  ],
}
