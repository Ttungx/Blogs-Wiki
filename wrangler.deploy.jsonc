{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blogs-wiki",
  "main": "./dist/server/_entry.mjs",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 内容更新定时触发：每 15 分钟 ping Render runner 一次（单源轮转）。
  // 2026-08-30 临时恢复（用户指令）：全量回填期 + 质量门禁 shadow 观察。
  // 观察期结束如需再次暂缓：crons 置 [] 并重新 deploy（见 docs/go-live.md）。
  "triggers": {
    "crons": ["7,22,37,52 * * * *"]
  },
  "vars": {
    "RUNNER_URL": "https://blogs-wiki-updater.onrender.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogs-wiki",
      "database_id": "6dd813ef-7d75-45ba-9a01-af3958b69725",
      "migrations_dir": "worker/migrations"
    }
  ],
}
