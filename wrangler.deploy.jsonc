{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blogs-wiki",
  "main": "./dist/server/_entry.mjs",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 2026-09-02 紧急暂停：每 15 分钟链尾全量 import+sync 打爆 D1 日写入配额。
  // 恢复前必须先落地增量 sync（见 docs/d1-write-budget.md），禁止只把 cron 打开。
  "triggers": {
    "crons": []
  },
  "vars": {
    "RUNNER_URL": "https://blogs-wiki-updater.onrender.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blogs-wiki",
      "database_id": "6dd813ef-7d75-45ba-9a01-af3958b69725",
      "migrations_dir": "worker/migrations"
    }
  ],
}
