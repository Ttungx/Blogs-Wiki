---
import type { StaticBlogEntry } from '../data/blogs-static';
import BlogMark from './BlogMark.astro';
import { sitePath } from '../lib/urls';

interface Props {
  blog: StaticBlogEntry;
  articleCount: number;
  index: number;
}

const { blog, articleCount, index } = Astro.props;
const { name, type, logo, avatar, logoScale } = blog.data;
---

<article class="shelf-card" style={`--shelf-index: ${index}`}>
  <a href={sitePath(`blogs/${blog.id}/`)} aria-label={`打开 ${name} 文章收集册`}>
    <BlogMark {name} {type} {logo} {avatar} {logoScale} size="medium" />
    <span class="shelf-card-copy">
      <strong>{name}</strong>
      <span class:list={['shelf-card-kind', { 'shelf-card-kind--personal': type === 'personal' }]}>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          {type === 'personal' ? (
            <path d="M8 7.2a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-4.25 6.1c.28-2.22 1.73-3.55 4.25-3.55s3.97 1.33 4.25 3.55H3.75Z"></path>
          ) : (
            <path d="M3 13.2V5.8l5-3 5 3v7.4M1.8 13.2h12.4M5.4 6.8v1M8 6.8v1m2.6-1v1M5.4 10v1M8 10v1m2.6-1v1"></path>
          )}
        </svg>
        {type === 'personal' ? '个人作者' : '机构博客'}
      </span>
      <span class="shelf-card-count">{articleCount} 篇文章</span>
    </span>
  </a>
</article>
