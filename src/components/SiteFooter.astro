---
interface Props {
  lang?: string;
}

const githubUrl = 'https://github.com/Ttungx/Blogs-Wiki';
const { lang = 'zh-CN' } = Astro.props as Props;
const isEnglish = lang.toLowerCase().startsWith('en');
---

<footer class="site-footer">
  <div class="footer-inner shell">
    <p>
      {isEnglish ? 'Blogs Wiki is an open index.' : 'Blogs Wiki 是一个开放索引。'}
      <a href={githubUrl} target="_blank" rel="noreferrer">
        {isEnglish ? 'Learn more on GitHub' : '在 GitHub 上了解更多'}
      </a>
    </p>
  </div>
</footer>
