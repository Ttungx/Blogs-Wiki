---
import CategoryPill from './CategoryPill.astro';
import RemoteImage from './RemoteImage.astro';
import { sitePath } from '../lib/urls';

interface Props {
  blogId: string;
  slug: string;
  title: string;
  originalTitle?: string;
  publishedAt: Date | string;
  categories: string[];
  imageUrl?: string;
}

const {
  blogId,
  slug,
  title,
  originalTitle,
  publishedAt,
  categories,
  imageUrl,
} = Astro.props;
const date = new Date(publishedAt);
// 中文是默认语言，列表项链接到不带语言段的路由
const href = sitePath(`articles/${blogId}/${slug}/`);
const year = String(date.getFullYear());
const month = String(date.getMonth() + 1).padStart(2, '0');
const day = String(date.getDate()).padStart(2, '0');
---

<article class:list={['article-row', { 'article-row--no-image': !imageUrl }]}>
  <a href={href} aria-label={`阅读：${title}`}>
    <time datetime={date.toISOString()}>
      <span>{year}</span>
      <span>/{month}/{day}</span>
    </time>
    <span class="article-row-main">
      <span class="article-row-title">{title}</span>
      {originalTitle && <span class="article-row-original" lang="en">{originalTitle}</span>}
      <span class="article-row-categories">
        {categories.map((category) => <CategoryPill label={category} quiet />)}
      </span>
    </span>
    {imageUrl && (
      <span class="article-row-image" aria-hidden="true">
        <RemoteImage
          src={imageUrl}
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.closest('.article-row-image')?.remove()"
        />
      </span>
    )}
  </a>
</article>
