---
import CategoryPill from './CategoryPill.astro';
import RemoteImage from './RemoteImage.astro';
import { sitePath } from '../lib/urls';

interface Props {
  id: string;
  translatedTitle: string;
  originalTitle: string;
  publishedAt: Date | string;
  categories: string[];
  imageUrl?: string;
}

const {
  id,
  translatedTitle,
  originalTitle,
  publishedAt,
  categories,
  imageUrl,
} = Astro.props;
const date = new Date(publishedAt);
// id 格式 `blogId/slug`，直接用于 URL 路径
const href = sitePath(`articles/${id}/`);
const year = String(date.getFullYear());
const month = String(date.getMonth() + 1).padStart(2, '0');
const day = String(date.getDate()).padStart(2, '0');
---

<article class:list={['article-row', { 'article-row--no-image': !imageUrl }]}>
  <a href={href} aria-label={`阅读：${translatedTitle}`}>
    <time datetime={date.toISOString()}>
      <span>{year}</span>
      <span>/{month}/{day}</span>
    </time>
    <span class="article-row-main">
      <span class="article-row-title">{translatedTitle}</span>
      <span class="article-row-original" lang="en">{originalTitle}</span>
      <span class="article-row-categories">
        {categories.map((category) => <CategoryPill label={category} quiet />)}
      </span>
    </span>
    {imageUrl && (
      <span class="article-row-image" aria-hidden="true">
        <RemoteImage
          src={imageUrl}
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.closest('.article-row-image')?.remove()"
        />
      </span>
    )}
  </a>
</article>
