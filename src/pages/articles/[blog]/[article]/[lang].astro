---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogMark from '../../../../components/BlogMark.astro';
import CategoryPill from '../../../../components/CategoryPill.astro';
import LanguageSwitcher from '../../../../components/LanguageSwitcher.astro';
import RemoteImage from '../../../../components/RemoteImage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { byOriginalPublicationDateDesc } from '../../../../lib/article-dates';
import { groupArticleKey, slugFromId } from '../../../../lib/article-id';
import { sitePath } from '../../../../lib/urls';

type ArticleGroup = CollectionEntry<'articles'>[];

export async function getStaticPaths() {
  const [blogs, articles] = await Promise.all([
    getCollection('blogs'),
    getCollection('articles'),
  ]);

  const groups = new Map<string, ArticleGroup>();
  for (const entry of articles) {
    const key = groupArticleKey(entry.id);
    let list = groups.get(key);
    if (!list) {
      list = [];
      groups.set(key, list);
    }
    list.push(entry);
  }

  return [...groups.values()].flatMap((siblings) => {
    // 每个非中文语言版本各生成一条路由
    const langEntries = siblings.filter((s) => s.data.language !== 'zh-cn');
    return langEntries.flatMap((langEntry) => {
      const [blogId] = langEntry.id.split('/');
      const slug = slugFromId(langEntry.id);
      const blog = blogs.find((b) => b.id === blogId);
      if (!blog) return [];

      const availableLanguages = siblings.map((s) => s.data.language).sort();

      // 相关文章：同 blogId 的其他文章，链接到中文默认版本
      const relatedArticles = [...groups.values()]
        .filter((g) => g !== siblings && g[0].id.split('/')[0] === blogId)
        .map((g) => g.find((s) => s.data.language === 'zh-cn'))
        .filter((s): s is CollectionEntry<'articles'> => s !== undefined)
        .sort(byOriginalPublicationDateDesc)
        .slice(0, 3);

      return [{
        params: { blog: blogId, article: slug, lang: langEntry.data.language },
        props: { article: langEntry, blog, relatedArticles, availableLanguages },
      }];
    });
  });
}

interface Props {
  article: CollectionEntry<'articles'>;
  blog: CollectionEntry<'blogs'>;
  relatedArticles: CollectionEntry<'articles'>[];
  availableLanguages: string[];
}

const { article, blog, relatedArticles, availableLanguages } = Astro.props;
const { Content } = await render(article);
const publishedDate = new Date(article.data.publishedAt);
const versionDate = new Date(article.data.versionAt);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const compactDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title={article.data.title}
  description={`${blog.data.name}：${article.data.title}`}
  pageClass="reader-page"
>
  <main id="main-content" data-pagefind-body>
    <article class="reader">
      <header class="reader-header shell">
        <a class="reader-source" href={sitePath(`blogs/${blog.id}/`)}>
          <BlogMark
            name={blog.data.name}
            type={blog.data.type}
            logo={blog.data.logo}
            avatar={blog.data.avatar}
            logoScale={blog.data.logoScale}
            size="small"
          />
          <span>
            <small>来自</small>
            <strong data-pagefind-filter="blog">{blog.data.name}</strong>
          </span>
          <i aria-hidden="true">↗</i>
        </a>

        <div class="reader-title-block">
          <h1 data-pagefind-meta="title">{article.data.title}</h1>
          <LanguageSwitcher
            availableLanguages={availableLanguages}
            currentLanguage={article.data.language}
            blogId={blog.id}
            slug={slugFromId(article.id)}
          />
        </div>

        <div class="reader-meta-grid">
          <div>
            <span>原文发表于</span>
            <strong>
              <time datetime={publishedDate.toISOString()}>{dateFormatter.format(publishedDate)}</time>
            </strong>
          </div>
          <div>
            <span>版本</span>
            <strong>
              <time datetime={versionDate.toISOString()}>{dateFormatter.format(versionDate)}</time>
            </strong>
          </div>
          <div>
            <span>分类</span>
            <p>
              {article.data.categories.map((category) => <CategoryPill label={category} />)}
            </p>
          </div>
          {article.data.translationModel && (
            <div>
              <span>翻译模型</span>
              <strong>{article.data.translationModel}</strong>
            </div>
          )}
          <div>
            <span>原文语言</span>
            <strong>{article.data.originalLanguage.toUpperCase()}</strong>
          </div>
          <a class="reader-meta-link" href={article.data.originalUrl} target="_blank" rel="noreferrer">
            查看原文 <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      {article.data.demo && (
        <aside class="demo-notice shell" aria-label="演示内容说明">
          <span>Demo</span>
          <p>此页用于验证内容模型与阅读排版，不代表完整官方译文。</p>
        </aside>
      )}

      <div class="reader-content prose">
        <Content components={{ img: RemoteImage }} />
      </div>

      {relatedArticles.length > 0 && (
        <section class="reader-related shell" aria-labelledby="reader-related-title">
          <header class="reader-related-heading">
            <div>
              <p class="eyebrow">Read next · 延伸阅读</p>
              <h2 id="reader-related-title">继续阅读</h2>
            </div>
            <a href={sitePath(`blogs/${blog.id}/`)}>查看全部文章 ↗</a>
          </header>
          <div class="reader-related-list">
            {relatedArticles.map((relatedArticle, index) => {
              const relatedDate = new Date(relatedArticle.data.publishedAt);
              return (
                <a href={sitePath(`articles/${relatedArticle.data.blogId}/${slugFromId(relatedArticle.id)}/`)}>
                  <span class="reader-related-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="reader-related-copy">
                    <strong>{relatedArticle.data.title}</strong>
                  </span>
                  <time datetime={relatedDate.toISOString()}>
                    {compactDateFormatter.format(relatedDate)}
                  </time>
                  <i aria-hidden="true">↗</i>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <footer class="reader-end shell">
        <div>
          <p>原文版权归原作者与来源网站所有。</p>
          <a href={article.data.originalUrl} target="_blank" rel="noreferrer">继续阅读原文 ↗</a>
        </div>
        <a class="back-to-collection" href={sitePath(`blogs/${blog.id}/`)}>
          <span aria-hidden="true">←</span>
          返回 {blog.data.name} 收藏册
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>
