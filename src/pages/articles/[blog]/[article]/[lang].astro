---
export const prerender = false;

import { getCollection } from 'astro:content';
import { env } from 'cloudflare:workers';
import BlogMark from '../../../../components/BlogMark.astro';
import CategoryPill from '../../../../components/CategoryPill.astro';
import LanguageSwitcher from '../../../../components/LanguageSwitcher.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { sitePath } from '../../../../lib/urls';
import { getArticle, getAvailableLanguages, listArticlesByBlog, parseDateSafe } from '../../../../lib/server/content';
import { renderMarkdown } from '../../../../lib/server/markdown';

const { blog: blogId, article: slug, lang } = Astro.params;
if (!blogId || !slug) return new Response('Not Found', { status: 404 });
// 语言白名单：只有 en 走语言段路由，其余一律视为中文默认路由（避免未知语言段悬空）
const targetLang = lang === 'en' ? 'en' : 'zh-cn';

const db = env.DB;
// 指定语言版本（默认兜底 en）
const articleData = await getArticle(db, blogId, slug, targetLang);
if (!articleData) return new Response('Not Found', { status: 404 });

// blogs 元数据仍从静态 collection 读取（构建期解析，SSR 可用）
const blogs = await getCollection('blogs');
const blog = blogs.find((b) => b.id === blogId);
if (!blog) return new Response('Not Found', { status: 404 });

// 渲染 markdown（D1 中的 content_markdown）
const html = await renderMarkdown(articleData.contentMarkdown, { baseUrl: articleData.originalUrl });

const relatedLanguage = targetLang === 'en' ? 'en' : 'zh-cn';
// 相关文章优先跟随当前阅读语言，避免 en 页首屏英文、列表突然回落中文。
const relatedArticles = (await listArticlesByBlog(db, blogId, relatedLanguage))
  .filter((a) => a.id !== articleData.id)
  .slice(0, 3);

// 可用语言（语言切换器）
const availableLanguages = await getAvailableLanguages(db, blogId, slug);

const publishedDate = parseDateSafe(articleData.publishedAt);
const translatedDate = parseDateSafe(articleData.translatedAt);
const versionDate = parseDateSafe(articleData.versionUpdatedAt);
const secondaryDate = translatedDate ?? versionDate;
const locale = targetLang === 'en' ? 'en-US' : 'zh-CN';
const t = {
  from: targetLang === 'en' ? 'From' : '来自',
  published: targetLang === 'en' ? 'Published' : '原文发表于',
  updated:
    targetLang === 'en'
      ? translatedDate
        ? 'Translation generated'
        : 'Catalog updated'
      : '收录更新',
  categories: targetLang === 'en' ? 'Categories' : '分类',
  readNextEyebrow: targetLang === 'en' ? 'Read next' : 'Read next · 延伸阅读',
  readNextTitle: targetLang === 'en' ? 'More articles' : '继续阅读',
  viewAll: targetLang === 'en' ? 'View all articles' : '查看全部文章',
  copyright:
    targetLang === 'en'
      ? 'Copyright remains with the original author and source site.'
      : '原文版权归原作者与来源网站所有。',
  continueOriginal: targetLang === 'en' ? 'Continue to original' : '继续阅读原文',
  backToCollection: targetLang === 'en' ? 'Back to collection' : `返回 ${blog.data.name} 收藏册`,
};
// meta description 分隔符跟随页面语言（en 页不用全角冒号）
const description =
  targetLang === 'en'
    ? `${blog.data.name}: ${articleData.title}`
    : `${blog.data.name}：${articleData.title}`;
const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={articleData.title}
  description={description}
  pageClass="reader-page"
  lang={targetLang === 'en' ? 'en' : 'zh-CN'}
>
  <main id="main-content" data-pagefind-body>
    <article class="reader">
      <header class="reader-header shell">
        <a class="reader-source" href={sitePath(`blogs/${blog.id}/`)}>
          <BlogMark
            name={blog.data.name}
            type={blog.data.type}
            logo={blog.data.logo}
            avatar={blog.data.avatar}
            logoScale={blog.data.logoScale}
            size="small"
          />
          <span>
            <small>{t.from}</small>
            <strong data-pagefind-filter="blog">{blog.data.name}</strong>
          </span>
          <i aria-hidden="true">↗</i>
        </a>

        <div class="reader-title-block">
          <h1 data-pagefind-meta="title">{articleData.title}</h1>
          <LanguageSwitcher
            availableLanguages={availableLanguages}
            currentLanguage={targetLang}
            blogId={blog.id}
            slug={slug}
          />
        </div>

        <div class="reader-meta-grid">
          <div>
            <span>{t.published}</span>
            <strong>
              {publishedDate && (
                <time datetime={publishedDate.toISOString()}>{dateFormatter.format(publishedDate)}</time>
              )}
            </strong>
          </div>
          {secondaryDate && (
            <div>
              <span>{t.updated}</span>
              <strong>
                <time datetime={secondaryDate.toISOString()}>{dateFormatter.format(secondaryDate)}</time>
              </strong>
            </div>
          )}
          <div>
            <span>{t.categories}</span>
            <p>
              {articleData.categories.map((category) => <CategoryPill label={category} />)}
            </p>
          </div>
        </div>
      </header>

      <div class="reader-content prose">
        <div set:html={html} />
      </div>

      {relatedArticles.length > 0 && (
        <section class="reader-related shell" aria-labelledby="reader-related-title">
          <header class="reader-related-heading">
            <div>
              <p class="eyebrow">{t.readNextEyebrow}</p>
              <h2 id="reader-related-title">{t.readNextTitle}</h2>
            </div>
            <a href={sitePath(`blogs/${blog.id}/`)}>{t.viewAll} ↗</a>
          </header>
          <div class="reader-related-list">
            {relatedArticles.map((relatedArticle, index) => {
              const relatedDate = parseDateSafe(relatedArticle.publishedAt);
              const relatedSlug = relatedArticle.id.split('/').slice(1).join('/');
              return (
                <a
                  href={sitePath(
                    relatedLanguage === 'en'
                      ? `articles/${relatedArticle.sourceId}/${relatedSlug}/en/`
                      : `articles/${relatedArticle.sourceId}/${relatedSlug}/`,
                  )}
                >
                  <span class="reader-related-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="reader-related-copy">
                    <strong>{relatedArticle.title}</strong>
                  </span>
                  {relatedDate && (
                    <time datetime={relatedDate.toISOString()}>{dateFormatter.format(relatedDate)}</time>
                  )}
                  <i aria-hidden="true">↗</i>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <footer class="reader-end shell">
        <div>
          <p>{t.copyright}</p>
          <a href={articleData.originalUrl} target="_blank" rel="noreferrer">{t.continueOriginal} ↗</a>
        </div>
        <a class="back-to-collection" href={sitePath(`blogs/${blog.id}/`)}>
          <span aria-hidden="true">←</span>
          {t.backToCollection}
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>
