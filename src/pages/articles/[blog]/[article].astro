---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogMark from '../../../components/BlogMark.astro';
import CategoryPill from '../../../components/CategoryPill.astro';
import RemoteImage from '../../../components/RemoteImage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { byOriginalPublicationDateDesc } from '../../../lib/article-dates';
import { sitePath } from '../../../lib/urls';

/** article.id 格式为 `blogId/slug`，取末段作为路由参数。 */
function slugFromId(id: string): string {
  const sep = id.indexOf('/');
  return sep >= 0 ? id.slice(sep + 1) : id;
}

export async function getStaticPaths() {
  // Astro 将 frontmatter helper 放入页面渲染函数；getStaticPaths 需要本地定义。
  const slugFromId = (id: string): string => {
    const sep = id.indexOf('/');
    return sep >= 0 ? id.slice(sep + 1) : id;
  };

  const [blogs, articles] = await Promise.all([
    getCollection('blogs'),
    getCollection('articles'),
  ]);

  return articles.flatMap((article) => {
    const blog = blogs.find((entry) => entry.id === article.data.blogId);
    const relatedArticles = articles
      .filter((entry) => entry.id !== article.id && entry.data.blogId === article.data.blogId)
      .sort(byOriginalPublicationDateDesc)
      .slice(0, 3);
    return blog
      ? [{ params: { blog: blog.id, article: slugFromId(article.id) }, props: { article, blog, relatedArticles } }]
      : [];
  });
}

interface Props {
  article: CollectionEntry<'articles'>;
  blog: CollectionEntry<'blogs'>;
  relatedArticles: CollectionEntry<'articles'>[];
}

const { article, blog, relatedArticles } = Astro.props;
const { Content } = await render(article);
const publishedDate = new Date(article.data.publishedAt);
const translatedDate = new Date(article.data.translatedAt);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const compactDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title={article.data.translatedTitle}
  description={`${blog.data.name}：${article.data.translatedTitle}`}
  pageClass="reader-page"
>
  <main id="main-content" data-pagefind-body>
    <article class="reader">
      <header class="reader-header shell">
        <a class="reader-source" href={sitePath(`blogs/${blog.id}/`)}>
          <BlogMark
            name={blog.data.name}
            type={blog.data.type}
            logo={blog.data.logo}
            avatar={blog.data.avatar}
            logoScale={blog.data.logoScale}
            size="small"
          />
          <span>
            <small>来自</small>
            <strong data-pagefind-filter="blog">{blog.data.name}</strong>
          </span>
          <i aria-hidden="true">↗</i>
        </a>

        <div class="reader-title-block">
          <h1 data-pagefind-meta="title">{article.data.translatedTitle}</h1>
          <p class="reader-original-title" lang="en">{article.data.originalTitle}</p>
        </div>

        <div class="reader-meta-grid">
          <div>
            <span>原文发表于</span>
            <strong>
              <time datetime={publishedDate.toISOString()}>{dateFormatter.format(publishedDate)}</time>
            </strong>
          </div>
          <div>
            <span>译于</span>
            <strong>
              <time datetime={translatedDate.toISOString()}>{dateFormatter.format(translatedDate)}</time>
            </strong>
          </div>
          <div>
            <span>分类</span>
            <p>
              {article.data.categories.map((category) => <CategoryPill label={category} />)}
            </p>
          </div>
          <div>
            <span>翻译模型</span>
            <strong>{article.data.translationModel}</strong>
          </div>
          <div>
            <span>原文语言</span>
            <strong>{article.data.originalLanguage.toUpperCase()}</strong>
          </div>
          <a class="reader-meta-link" href={article.data.originalUrl} target="_blank" rel="noreferrer">
            查看原文 <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      {article.data.demo && (
        <aside class="demo-notice shell" aria-label="演示内容说明">
          <span>Demo</span>
          <p>此页用于验证内容模型与阅读排版，不代表完整官方译文。</p>
        </aside>
      )}

      <div class="reader-content prose">
        <Content components={{ img: RemoteImage }} />
      </div>

      {relatedArticles.length > 0 && (
        <section class="reader-related shell" aria-labelledby="reader-related-title">
          <header class="reader-related-heading">
            <div>
              <p class="eyebrow">Read next · 延伸阅读</p>
              <h2 id="reader-related-title">继续阅读</h2>
            </div>
            <a href={sitePath(`blogs/${blog.id}/`)}>查看全部文章 ↗</a>
          </header>
          <div class="reader-related-list">
            {relatedArticles.map((relatedArticle, index) => {
              const relatedDate = new Date(relatedArticle.data.publishedAt);
              return (
                <a href={sitePath(`articles/${relatedArticle.data.blogId}/${slugFromId(relatedArticle.id)}/`)}>
                  <span class="reader-related-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="reader-related-copy">
                    <strong>{relatedArticle.data.translatedTitle}</strong>
                    <small lang="en">{relatedArticle.data.originalTitle}</small>
                  </span>
                  <time datetime={relatedDate.toISOString()}>
                    {compactDateFormatter.format(relatedDate)}
                  </time>
                  <i aria-hidden="true">↗</i>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <footer class="reader-end shell">
        <div>
          <p>原文版权归原作者与来源网站所有。</p>
          <a href={article.data.originalUrl} target="_blank" rel="noreferrer">继续阅读原文 ↗</a>
        </div>
        <a class="back-to-collection" href={sitePath(`blogs/${blog.id}/`)}>
          <span aria-hidden="true">←</span>
          返回 {blog.data.name} 收集册
        </a>
      </footer>
    </article>
  </main>
</BaseLayout>
