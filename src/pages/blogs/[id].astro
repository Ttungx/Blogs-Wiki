---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleRow from '../../components/ArticleRow.astro';
import BlogMark from '../../components/BlogMark.astro';
import CategoryPill from '../../components/CategoryPill.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byOriginalPublicationDateDesc } from '../../lib/article-dates';
import { slugFromId } from '../../lib/article-id';
import { sitePath } from '../../lib/urls';

export async function getStaticPaths() {
  const [blogs, articles] = await Promise.all([
    getCollection('blogs'),
    getCollection('articles'),
  ]);

  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: {
      blog,
      articles: articles
        .filter((article) => article.data.blogId === blog.id && article.data.language === 'zh-cn')
        .sort(byOriginalPublicationDateDesc),
    },
  }));
}

interface Props {
  blog: CollectionEntry<'blogs'>;
  articles: CollectionEntry<'articles'>[];
}

const { blog, articles } = Astro.props;
const { name, type, logo, avatar, description, blogUrl, homepageUrl, categories = [] } = blog.data;

function firstRemoteImage(markdown: string | undefined): string | undefined {
  const match = markdown?.match(/!\[[^\]]*\]\((https?:\/\/[^\s)]+(?:\?[^\s)]*)?)/i);
  return match?.[1];
}

function imageFor(article: CollectionEntry<'articles'>): string | undefined {
  return article.data.imageUrl ?? firstRemoteImage(article.body);
}

const [featuredArticle, ...remainingArticles] = articles;
const featuredImage = featuredArticle ? imageFor(featuredArticle) : undefined;
const featuredDate = featuredArticle ? new Date(featuredArticle.data.publishedAt) : undefined;
const featuredDateText = featuredDate
  ? `${featuredDate.getFullYear()}/${String(featuredDate.getMonth() + 1).padStart(2, '0')}/${String(featuredDate.getDate()).padStart(2, '0')}`
  : '';
---

<BaseLayout title={name} description={description} pageClass="collection-page">
  <main id="main-content" data-pagefind-body>
    <section class="collection-hero shell">
      <div class="collection-identity">
        <BlogMark {name} {type} {logo} {avatar} logoScale={blog.data.logoScale} size="large" />
        <div>
          <p class="eyebrow">{type === 'personal' ? 'Independent archive' : 'Publication archive'}</p>
          <h1 data-pagefind-meta="title">{name}</h1>
        </div>
      </div>

      <div class="collection-intro">
        <p>{description}</p>
        <a href={blogUrl ?? homepageUrl} target="_blank" rel="noreferrer">
          访问原博客 <span aria-hidden="true">↗</span>
        </a>
      </div>

      <dl class="collection-facts">
        <div>
          <dt>馆藏</dt>
          <dd>{articles.length} 篇文章</dd>
        </div>
        <div>
          <dt>来源</dt>
          <dd>{type === 'personal' ? '独立作者' : '公司 / 机构'}</dd>
        </div>
        <div>
          <dt>主题</dt>
          <dd class="fact-tags">
            {categories.map((category) => <CategoryPill label={category} />)}
          </dd>
        </div>
      </dl>
    </section>

    <section class="collection-index shell" aria-labelledby="article-index-title">
      {featuredArticle ? (
        <article class="featured-article">
          <a
            class:list={['featured-article-link', { 'featured-article-link--no-image': !featuredImage }]}
            href={sitePath(`articles/${blog.id}/${slugFromId(featuredArticle.id)}/`)}
          >
            <span class="featured-article-copy">
              <span class="eyebrow">Latest · 最新</span>
              <strong>{featuredArticle.data.title}</strong>
              {featuredArticle.data.excerpt && (
                <span class="featured-article-excerpt">{featuredArticle.data.excerpt}</span>
              )}
              <span class="featured-article-meta">
                <time datetime={featuredDate?.toISOString()}>{featuredDateText}</time>
                {featuredArticle.data.categories.map((category) => <CategoryPill label={category} quiet />)}
              </span>
            </span>
            {featuredImage && (
              <span class="featured-article-image" aria-hidden="true">
                <RemoteImage
                  src={featuredImage}
                  alt=""
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  referrerpolicy="no-referrer"
                  onerror="this.closest('.featured-article-image')?.remove()"
                />
              </span>
            )}
          </a>
        </article>
      ) : null}

      <header class="article-index-heading">
        <p id="article-index-title">Collected writing <span>/ 全部文章</span></p>
        <span>按原文发表日期排序 <i aria-hidden="true">⌄</i></span>
      </header>

      <div class="article-list">
        {remainingArticles.length ? remainingArticles.map((article) => (
          <ArticleRow
            blogId={blog.id}
            slug={slugFromId(article.id)}
            title={article.data.title}
            publishedAt={article.data.publishedAt}
            categories={article.data.categories}
            imageUrl={imageFor(article)}
          />
        )) : !featuredArticle ? (
          <div class="empty-state">
            <strong>还没有收录文章</strong>
            <span>更新流程发现新文章后会出现在这里。</span>
          </div>
        ) : null}
      </div>
    </section>
  </main>
</BaseLayout>
