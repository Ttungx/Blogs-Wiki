---
import { env } from 'cloudflare:workers';
import { staticBlogs } from '../data/blogs-static';
import SearchPanel from '../components/SearchPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listAllArticlesForSearch, parseDateSafe } from '../lib/server/content';
import { sitePath } from '../lib/urls';

export const prerender = false;

// 博客元数据来自静态集合（轻量）；文章清单改读 D1——
// 此前 getCollection('articles') 会把全部文章正文打进服务端 bundle，
// 是 Worker 64MiB 体积上限超限的元凶。
const blogs = staticBlogs;
const zhArticles = await listAllArticlesForSearch(env.DB, 'zh-cn');

const blogNames = new Map(blogs.map((blog) => [blog.id, blog.data.name]));
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});

const items = [
  ...blogs.map((blog) => ({
    kind: 'blog' as const,
    title: blog.data.name,
    subtitle: blog.data.type === 'personal' ? '独立作者' : '公司 / 机构',
    url: sitePath(`blogs/${blog.id}/`),
    categories: blog.data.categories,
  })),
  ...zhArticles.map((article) => {
    const publishedAt = parseDateSafe(article.publishedAt);
    // D1 文章 id 为 `blogId/slug`，slug 取首个斜杠之后的部分。
    const slug = article.id.split('/').slice(1).join('/');
    return {
      kind: 'article' as const,
      title: article.title,
      subtitle: blogNames.get(article.sourceId) ?? article.sourceDomain,
      url: sitePath(`articles/${article.sourceId}/${slug}/`),
      ...(publishedAt ? { date: dateFormatter.format(publishedAt) } : {}),
      categories: article.categories,
    };
  }),
];
---

<BaseLayout title="搜索" description="搜索 Blogs Wiki 收录的博客与文章。" pageClass="search-page">
  <main id="main-content" class="search-main shell">
    <header class="search-hero">
      <p class="eyebrow">Search the archive</p>
      <h1>搜索馆藏</h1>
      <p>从博客名称、作者、双语标题，到文章正文。</p>
    </header>
    <SearchPanel {items} />
  </main>
</BaseLayout>
