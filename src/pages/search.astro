---
import { getCollection } from 'astro:content';
import SearchPanel from '../components/SearchPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { byOriginalPublicationDateDesc } from '../lib/article-dates';
import { sitePath } from '../lib/urls';

const [blogs, articles] = await Promise.all([
  getCollection('blogs'),
  getCollection('articles'),
]);
const blogNames = new Map(blogs.map((blog) => [blog.id, blog.data.name]));
const articlesByPublicationDate = [...articles].sort(byOriginalPublicationDateDesc);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});

const items = [
  ...blogs.map((blog) => ({
    kind: 'blog' as const,
    title: blog.data.name,
    subtitle: blog.data.type === 'personal' ? '独立作者' : '公司 / 机构',
    url: sitePath(`blogs/${blog.id}/`),
    categories: blog.data.categories,
  })),
  ...articlesByPublicationDate.map((article) => ({
    kind: 'article' as const,
    title: article.data.translatedTitle,
    originalTitle: article.data.originalTitle,
    subtitle: blogNames.get(article.data.blogId) ?? article.data.sourceDomain,
    url: sitePath(`articles/${article.id}/`),
    date: dateFormatter.format(article.data.publishedAt),
    categories: article.data.categories,
  })),
];
---

<BaseLayout title="搜索" description="搜索 Blogs Wiki 收录的博客与文章。" pageClass="search-page">
  <main id="main-content" class="search-main shell">
    <header class="search-hero">
      <p class="eyebrow">Search the archive</p>
      <h1>搜索馆藏</h1>
      <p>从博客名称、作者、双语标题，到文章正文。</p>
    </header>
    <SearchPanel {items} />
  </main>
</BaseLayout>
