---
import { getCollection } from 'astro:content';
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogShelfCard from '../components/BlogShelfCard.astro';
import { getArticleCountBySource } from '../lib/server/content';

export const prerender = false;

const blogs = await getCollection('blogs');

const db = env.DB;
// 每来源文章计数来自 D1（只计有 zh-cn 版本的文章）
const articleCount = await getArticleCountBySource(db, 'zh-cn');

const companyBlogs = blogs
  .filter((blog) => blog.data.type === 'company')
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const personalBlogs = blogs
  .filter((blog) => blog.data.type === 'personal')
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout description="持续收录高质量博客文章，并提供统一的中文翻译阅读体验。" pageClass="home-page">
  <main id="main-content">
    <section class="home-hero shell">
      <h1>
        <span>值得读的博客</span>
        <span>不该被语言阻隔</span>
      </h1>
      <p>精选 AI、技术与更广阔世界中的优质博客。</p>
      <div class="hero-divider" aria-hidden="true"><span>✦</span></div>
    </section>

    <section class="shelf shell" aria-labelledby="shelf-title">
      <h2 id="shelf-title" class="visually-hidden">博客索引</h2>

      <div class="shelf-grid">
        {companyBlogs.map((blog, index) => (
          <BlogShelfCard blog={blog} articleCount={articleCount.get(blog.id) ?? 0} {index} />
        ))}
      </div>
      {personalBlogs.length > 0 && (
        <div class="shelf-grid shelf-grid--people">
          {personalBlogs.map((blog, index) => (
            <BlogShelfCard
              blog={blog}
              articleCount={articleCount.get(blog.id) ?? 0}
              index={companyBlogs.length + index}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</BaseLayout>
