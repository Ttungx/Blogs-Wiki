---
import { staticBlogs } from '../data/blogs-static';
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogShelfCard from '../components/BlogShelfCard.astro';
import { getArticleCountBySource } from '../lib/server/content';

export const prerender = false;

const blogs = staticBlogs;

const db = env.DB;
// 每来源已发布文章计数来自 D1（含原文/译文任一语言版本）
const articleCount = await getArticleCountBySource(db);

const hasArticles = (id: string) => (articleCount.get(id) ?? 0) > 0;
// demo 展示条目（如 Paul Graham）保留展示位，不受 D1 文章数过滤
const visible = (id: string, demo?: boolean) => demo === true || hasArticles(id);
const companyBlogs = blogs
  .filter((blog) => blog.data.type === 'company' && visible(blog.id, blog.data.demo))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const personalBlogs = blogs
  .filter((blog) => blog.data.type === 'personal' && visible(blog.id, blog.data.demo))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout description="持续收录高质量博客文章，并提供统一的中文翻译阅读体验。" pageClass="home-page">
  <main id="main-content">
    <section class="home-hero shell">
      <h1>
        <span>值得读的博客</span>
        <span>不该被语言阻隔</span>
      </h1>
      <p>精选 AI、技术与更广阔世界中的优质博客。</p>
      <div class="hero-divider" aria-hidden="true"><span>✦</span></div>
    </section>

    <section class="shelf shell" aria-labelledby="shelf-title">
      <h2 id="shelf-title" class="visually-hidden">博客索引</h2>

      <div class="shelf-grid">
        {companyBlogs.map((blog, index) => (
          <BlogShelfCard blog={blog} articleCount={articleCount.get(blog.id) ?? 0} {index} />
        ))}
      </div>
      {personalBlogs.length > 0 && (
        <div class="shelf-grid shelf-grid--people">
          {personalBlogs.map((blog, index) => (
            <BlogShelfCard
              blog={blog}
              articleCount={articleCount.get(blog.id) ?? 0}
              index={companyBlogs.length + index}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</BaseLayout>
