OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
TRANSLATION_MODEL=
# low（high 会因 reasoning 吃满 max_tokens 致翻译输出空；Gemini 不接受 default）
MODEL_REASONING_EFFORT=low
SITE_URL=
BASE_PATH=/
USE_PROXY=false
PROXY_URL=http://127.0.0.1:7897

# 抓取引擎：worker（Defuddle + linkedom，Cloudflare 兼容）或 node（Readability）
FETCH_BACKEND=worker

# ── 内容更新链（Render runner / 本地 Node 路径，见 docs/go-live.md）──
# 写 D1 认证与端点（本地联调时指向线上受保护端点）
CONTENT_SYNC_TOKEN=
CONTENT_SYNC_URL=https://blogswiki.dpdns.org/api/content-sync/
CONTENT_SYNC_CHECK_URL=https://blogswiki.dpdns.org/api/content-sync/check/
# 翻译管线：v1（默认整篇）| v2（强制分块）；>100K 字符自动兜底 v2
TRANSLATION_PIPELINE=v1
# Render runner 切片（分钟）与每源单次上限（空 = sources.json 配置）
RUN_INTERVAL_MINUTES=15
UPDATE_LIMIT=
# AI 多服务商槽位（可选）：1|2|3，槽位变量 AI_PROVIDER_<n>_BASE_URL/_API_KEY/_MODEL/_REASONING_EFFORT
AI_PROVIDER=
